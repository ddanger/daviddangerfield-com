{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resume",
  "description": "Resume content, rendered by scripts/lib/resume-html.mjs to the /resume/ page and printed as Resume-David-Dangerfield.pdf. Ids are stable handles for selecting content (for example, bullets in a tailored variant); change wording freely, but don't reuse an id for a different fact.",
  "type": "object",
  "required": [
    "name",
    "headline",
    "industries",
    "contact",
    "summary",
    "availability",
    "skills",
    "jobs",
    "education"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "month": {
      "description": "YYYY-MM, shown as \"Mar 2025\".",
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "headline": {
      "description": "Shown on one line, joined with \" | \".",
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "industries": {
      "description": "Shown on one line, joined with \" | \".",
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "contact": {
      "description": "No email or phone: recruiters David works with reject resumes that include them.",
      "type": "object",
      "required": ["location", "links"],
      "additionalProperties": false,
      "properties": {
        "location": { "type": "string" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "summary": { "type": "string" },
    "availability": { "description": "Bold line after the summary.", "type": "string" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "items"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "jobs": {
      "description": "Most recent first, in display order.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "employer", "location", "start", "bullets", "tech"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string" },
          "engagement": {
            "description": "Shown in parentheses after the title, like \"Contractor\".",
            "type": "string"
          },
          "employer": { "type": "string" },
          "employerNote": {
            "description": "Shown in parentheses after the employer, like \"now Boston Scientific\".",
            "type": "string"
          },
          "location": { "description": "A city, or \"Remote\".", "type": "string" },
          "start": { "$ref": "#/$defs/month" },
          "end": {
            "description": "Omit for a current role (shown as \"Present\").",
            "$ref": "#/$defs/month"
          },
          "bullets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "lead", "text"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "lead": {
                  "description": "The bold opening phrase. Must be exactly the start of text.",
                  "type": "string"
                },
                "text": { "description": "The whole bullet, lead included.", "type": "string" }
              }
            }
          },
          "tech": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["degree", "school", "location", "year"],
        "additionalProperties": false,
        "properties": {
          "degree": { "type": "string" },
          "school": { "type": "string" },
          "location": { "type": "string" },
          "year": { "type": "integer" }
        }
      }
    }
  }
}
