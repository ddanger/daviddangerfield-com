# Cloudflare Pages edge headers. Copied to dist/_headers by
# scripts/lib/static-assets.mjs's HOST_CONFIG_FILES on every build. That's
# the filename Cloudflare Pages requires at the published root. This is the
# header config (caching and security) for the whole site, as code.
#
# Cache-Control never goes in the catch-all `/*` rule: verified against a
# live deployment that Cloudflare Pages does NOT apply "most specific path
# wins" the way Netlify docs describe it. A `/*` rule's Cache-Control gets
# concatenated onto a more specific rule's value instead of being overridden
# by it, producing a single header with both (conflicting) directives. So
# every path below is listed for the caching it actually needs, and paths
# with no rule get Cloudflare Pages' own default instead of an explicit one.
#
# The `/*` rule is only for headers no other rule sets, so there's nothing
# for them to be concatenated with.

# Security headers for every response. HSTS deliberately omits
# includeSubDomains and preload, so it can't affect other subdomains.
/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Fingerprinted script: script.js?v=<content-hash> is generated by
# scripts/build.mjs on every build, so the URL itself changes whenever the
# content does. Safe to tell browsers to never revalidate.
/script.js
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted font subsets. Filenames don't change; if a font file's content
# ever changes under the same name, purge the Cloudflare cache after deploy.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Size-suffixed image variants: same "filename implies content" assumption
# as fonts.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# The resume PDF is updated manually via `npm run update:resume`, which bumps the
# ?v= query param used on-site, but the bare URL below isn't fingerprinted
# (it's also linked externally, e.g. LinkedIn), so keep this moderate rather
# than immutable.
/Resume-David-Dangerfield.pdf
  Cache-Control: public, max-age=86400, must-revalidate
