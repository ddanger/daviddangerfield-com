# Published as dist/_headers (scripts/lib/static-assets.mjs).
#
# /* must only set headers that no other rule sets. Cloudflare Pages doesn't let
# a specific path override /*: it concatenates both values into one
# conflicting header (verified on a live deploy). So Cache-Control is set per
# path, and paths without a rule get the Pages default.

# HSTS omits includeSubDomains and preload so it can't affect other subdomains.
/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The build versions the script URL by content hash, so it can be immutable.
/script.js
  Cache-Control: public, max-age=31536000, immutable

# Filenames never change. If a file's content does, purge the Cloudflare cache.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Same rule as fonts.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# The bare URL is linked externally (LinkedIn) and isn't versioned, so it
# can't be immutable.
/Resume-David-Dangerfield.pdf
  Cache-Control: public, max-age=86400, must-revalidate
